{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ai-dev-pipeline/schema/verify.schema.json",
  "title": "verify.json",
  "description": "Verdict of a local PR review verify pass. clean may be true only when nothing is reopened and no new finding was raised.",
  "type": "object",
  "required": [
    "ok",
    "reopen",
    "new_findings",
    "clean"
  ],
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reopen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "thread",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "thread": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "new_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9A-Za-z_-]+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "major",
              "minor",
              "info"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "completeness",
              "tests",
              "security",
              "performance",
              "maintainability",
              "conventions",
              "scope",
              "documentation"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "location": {
            "type": "object",
            "required": [
              "path",
              "line",
              "side"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "side": {
                "type": "string",
                "enum": [
                  "LEFT",
                  "RIGHT"
                ]
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "suggestion": {
            "type": [
              "string",
              "null"
            ]
          },
          "related_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    },
    "clean": {
      "type": "boolean"
    }
  },
  "if": {
    "properties": {
      "clean": {
        "const": true
      }
    },
    "required": [
      "clean"
    ]
  },
  "then": {
    "properties": {
      "reopen": {
        "maxItems": 0
      },
      "new_findings": {
        "maxItems": 0
      }
    }
  }
}
